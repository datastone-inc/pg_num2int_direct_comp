-- The rewrite of a left-hand constant keeps the direction:
-- 10.5 < pk means pk > 10.5, i.e. pk >= 11.
EXPLAIN (COSTS OFF) SELECT * FROM ex_int4 WHERE 10.5::numeric < pk;
      QUERY PLAN      
----------------------
 Seq Scan on ex_int4
   Filter: (pk >= 11)
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM ex_int4 WHERE 10.5::float8 >= pk;
      QUERY PLAN      
----------------------
 Seq Scan on ex_int4
   Filter: (pk <= 10)
(2 rows)

